# Copy to .env and fill with your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/taskdb
SECRET_KEY=your-super-secret-key-min-32-chars
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskdb
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
